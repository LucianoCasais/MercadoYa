{
  "realm": "mercadoya",
  "displayName": "MercadoYa",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrador del comercio"
      },
      {
        "name": "cliente",
        "description": "Cliente de la tienda"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-mercadoya",
    "description": "Roles por defecto: todo usuario registrado es cliente",
    "composite": true,
    "composites": {
      "realm": [
        "offline_access",
        "uma_authorization",
        "cliente"
      ]
    }
  },
  "clients": [
    {
      "clientId": "web",
      "name": "MercadoYa Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "audience-mercadoya-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mercadoya-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "orders-worker",
      "name": "Worker de pedidos (servicio)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-mercadoya-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "mercadoya-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mercadoya-api",
      "name": "MercadoYa API (audience)",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true
    }
  ],
  "users": [
    {
      "username": "admin@mercadoya.local",
      "email": "admin@mercadoya.local",
      "firstName": "Admin",
      "lastName": "MercadoYa",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "cliente@mercadoya.local",
      "email": "cliente@mercadoya.local",
      "firstName": "Cliente",
      "lastName": "Prueba",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Cliente123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "cliente"
      ]
    }
  ]
}
