    "/api/v1/admin/products/{id}/stock": {
      "patch": {
        "description": "Suma (`delta` positivo) o resta (negativo) unidades y registra un movimiento de stock 'Ajuste'. `delta` no puede ser 0 ni pasar el máximo permitido, y el stock no puede quedar en negativo (409).\n\n**Acceso:** solo el rol `admin`.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockAdjustRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockAdjustedDto"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Falta el token o no es válido (vencido, firma, emisor o audiencia incorrectos)."
          },
          "403": {
            "description": "El token es válido pero su rol no tiene permiso para esta operación."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Ajustar el stock de un producto",
        "tags": [
          "Admin - Productos"
        ]
      }
    },
    "/api/v1/categories": {
