              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Falta el token o no es válido (vencido, firma, emisor o audiencia incorrectos)."
          },
          "403": {
            "description": "El token es válido pero su rol no tiene permiso para esta operación."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Consultar un pedido",
        "tags": [
          "Pedidos"
        ]
      }
    },
    "/api/v1/products": {
      "get": {
        "description": "Productos activos, ordenados por nombre. `search` busca en el nombre sin distinguir mayúsculas ni tildes (hasta 100 caracteres); `categoryId` incluye las subcategorías; `pageSize` admite hasta 50. La respuesta lleva el header `X-Cache` (HIT o MISS).",
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "categoryId",
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "default": 12,
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDtoPagedResult"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          }
        },
        "summary": "Listar productos",
        "tags": [
          "Catálogo"
        ]
      }
    },
