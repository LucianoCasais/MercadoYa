          },
          "403": {
            "description": "El token es válido pero su rol no tiene permiso para esta operación."
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Listar productos (admin)",
        "tags": [
          "Admin - Productos"
        ]
      },
      "post": {
        "description": "Crea el producto activo y registra su stock inicial como movimiento 'Inicial', en una sola transacción. Responde 201 con el header `Location`.\n\n**Acceso:** solo el rol `admin`.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminProductDto"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Falta el token o no es válido (vencido, firma, emisor o audiencia incorrectos)."
          },
          "403": {
            "description": "El token es válido pero su rol no tiene permiso para esta operación."
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Crear un producto",
        "tags": [
          "Admin - Productos"
        ]
      }
    },
