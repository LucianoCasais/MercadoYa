    "/api/v1/orders": {
      "post": {
        "description": "Crea el pedido con los precios actuales y lo deja Pendiente. El cuerpo lleva hasta 50 líneas de producto y cantidad (hasta 99 por producto). 202: el pedido se aceptó y lo resuelve el worker; el resultado se consulta con `GET /orders/{id}`. 200: el pedido ya existía (reintento con el mismo `Idempotency-Key`: no se duplica). 503: no se pudo enviar el pedido a procesar (el pedido queda Rechazado).\n\n**Acceso:** solo el rol `cliente`.",
        "parameters": [
          {
            "description": "Clave que identifica esta compra (hasta 100 caracteres, por ejemplo un GUID). Repetir la request con la misma clave devuelve el mismo pedido y no lo duplica.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            },
            "description": "OK"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            },
            "description": "Accepted"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Falta el token o no es válido (vencido, firma, emisor o audiencia incorrectos)."
          },
          "403": {
            "description": "El token es válido pero su rol no tiene permiso para esta operación."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Crear un pedido (checkout)",
        "tags": [
          "Pedidos"
        ]
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "description": "Seguimiento del pedido: estado (Pendiente, Confirmado, Rechazado, Entregado o Cancelado), motivo del rechazo e ítems. Solo lo ve su dueño; el de otro usuario responde 404.\n\n**Acceso:** solo el rol `cliente`.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
