  "info": {
    "description": "API REST de MercadoYa: catálogo público, checkout de clientes, administración de productos, stock y pedidos, y endpoints internos del worker.\n\n**Autenticación:** JWT de Keycloak (realm `mercadoya`). Para probar los endpoints protegidos, obtené un token, apretá **Authorize** y pegalo (sin la palabra Bearer).\n\n**Errores:** todos siguen ProblemDetails (RFC 9457). Cada respuesta lleva el header `X-Correlation-Id`, útil para reportar un problema; también se puede enviar uno propio en la request.\n\n**Compra asíncrona:** `POST /api/v1/orders` responde 202 con el pedido Pendiente; el resultado final se consulta con `GET /api/v1/orders/{id}`.",
    "title": "MercadoYa API",
    "version": "v1"
  },
  "openapi": "3.0.1",
  "paths": {
    "/api/v1/admin/orders": {
      "get": {
        "description": "Pedidos de todos los clientes, los más nuevos primero. `status` filtra por estado (Pendiente, Confirmado, Rechazado, Entregado o Cancelado).\n\n**Acceso:** solo el rol `admin`.",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "schema": {
              "default": 20,
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminOrderPage"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Falta el token o no es válido (vencido, firma, emisor o audiencia incorrectos)."
          },
          "403": {
            "description": "El token es válido pero su rol no tiene permiso para esta operación."
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Listar pedidos",
        "tags": [
          "Admin - Pedidos"
        ]
      }
    },
    "/api/v1/admin/orders/{id}": {
      "get": {
        "description": "**Acceso:** solo el rol `admin`.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Falta el token o no es válido (vencido, firma, emisor o audiencia incorrectos)."
          },
          "403": {
            "description": "El token es válido pero su rol no tiene permiso para esta operación."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Ver un pedido",
        "tags": [
          "Admin - Pedidos"
        ]
      }
    },
    "/api/v1/admin/orders/{id}/status": {
      "patch": {
        "description": "Solo desde Confirmado: pasa a `Entregado` o `Cancelado` (cancelar libera el stock reservado). Cualquier otro cambio responde 409.\n\n**Acceso:** solo el rol `admin`.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeOrderStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Falta el token o no es válido (vencido, firma, emisor o audiencia incorrectos)."
          },
          "403": {
            "description": "El token es válido pero su rol no tiene permiso para esta operación."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Conflict"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Cambiar el estado de un pedido",
        "tags": [
          "Admin - Pedidos"
        ]
      }
    },
    "/api/v1/admin/products": {
      "get": {
        "description": "Incluye los productos inactivos. `search` busca por nombre sin distinguir mayúsculas ni tildes; `pageSize` admite hasta 100.\n\n**Acceso:** solo el rol `admin`.",
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
